# Copy to .env.local (npm) or .env (docker compose). Everything is optional:
# the app works out of the box with Ollama on localhost and is configured in Settings.

# Where your data lives (SQLite + photos). Default: ./data
# SOCIALBOOST_DATA_DIR=./data

# Local models (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
SOCIALBOOST_WRITER_MODEL=gemma4:12b
# SOCIALBOOST_FAST_MODEL=gemma4:12b
# SOCIALBOOST_VISION_MODEL=gemma4:12b   (defaults to the writer model; it reads photos too)
SOCIALBOOST_EMBED_MODEL=embeddinggemma
# SOCIALBOOST_NUM_CTX=8192

# Any OpenAI-compatible server (LM Studio, llama.cpp, vLLM, OpenRouter, OpenAI...)
# OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPAT_API_KEY=

# Anthropic (optional cloud fallback)
# ANTHROPIC_API_KEY=

# Speech-to-text for voice answers (OpenAI-compatible Whisper server, e.g. speaches)
# STT_BASE_URL=http://localhost:8000/v1
# STT_MODEL=Systran/faster-whisper-small

# LinkedIn publishing (optional; can also be set in Settings → LinkedIn)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# The redirect URL must match the address your browser uses (default: <origin>/api/linkedin/callback)
# LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
# LINKEDIN_API_VERSION=202609

# Background publisher: set to 1 to turn it off. Posts more than N minutes late
# (laptop asleep) are not auto-published; they show as "Due" instead.
# SOCIALBOOST_DISABLE_SCHEDULER=0
# SOCIALBOOST_PUBLISH_GRACE_MINUTES=120

# Running it online? Set a password to put the whole studio behind a sign-in screen.
# SOCIALBOOST_PASSWORD=
